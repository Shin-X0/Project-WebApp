{% extends 'admin/layout.html.twig' %}

{% block title %}Order — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <h1>Order Details</h1>
    <div class="admin-actions">
      <a href="{{ path('app_admin_orders_edit', {'id': order.id}) }}" class="btn">
        <span class="icon">&#9998;</span>
        <span>Edit</span>
      </a>
      <a href="{{ path('app_admin_orders_index') }}" class="btn">
        <span class="icon">&#8592;</span>
        <span>Back to list</span>
      </a>
    </div>
  </header>

  <div class="admin-form">
    <table class="admin-table">
      <tbody>
        <tr><th>Id</th><td>{{ order.id }}</td></tr>
        <tr><th>Order #</th><td class="cell-mono">{{ order.orderNo }}</td></tr>
        <tr><th>Name</th><td>{{ order.name }}</td></tr>
        <tr><th>Email</th><td class="cell-muted">{{ order.email }}</td></tr>
        <tr><th>Address</th><td>{{ order.address }}</td></tr>
        <tr><th>City</th><td>{{ order.city }}</td></tr>
        <tr><th>Zip</th><td class="cell-mono">{{ order.zip }}</td></tr>
        <tr><th>Method</th><td>{{ order.paymentMethod }}</td></tr>
        <tr><th>Status</th><td><span class="admin-badge badge-{{ order.status }}">{{ order.status }}</span></td></tr>
        <tr><th>Total</th><td class="cell-mono">{{ order.total }}</td></tr>
        <tr><th>Created At</th><td class="cell-muted">{{ order.createdAt ? order.createdAt|date('Y-m-d H:i:s') : '' }}</td></tr>
      </tbody>
    </table>
  </div>
{% endblock %}
