{% extends 'admin/layout.html.twig' %}

{% block title %}Order — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <h1>Order Details</h1>
    <div class="admin-actions">
      <a href="{{ path('app_admin_orders_edit', {'id': order.id}) }}" class="btn">
        <span class="icon">&#9998;</span>
        <span>Edit</span>
      </a>
      <a href="{{ path('app_admin_orders_index') }}" class="btn">
        <span class="icon">&#8592;</span>
        <span>Back to list</span>
      </a>
    </div>
  </header>

  <div class="admin-form">
    <table class="admin-table">
      <tbody>
        <tr><th>Id</th><td>{{ order.id }}</td></tr>
        <tr><th>Order #</th><td class="cell-mono">{{ order.orderNo }}</td></tr>
        <tr><th>Name</th><td>{{ order.name }}</td></tr>
        <tr><th>Email</th><td class="cell-muted">{{ order.email }}</td></tr>
        <tr><th>Address</th><td>{{ order.address }}</td></tr>
        <tr><th>City</th><td>{{ order.city }}</td></tr>
        <tr><th>Zip</th><td class="cell-mono">{{ order.zip }}</td></tr>
        <tr><th>Method</th><td>{{ order.paymentMethod }}</td></tr>
        <tr><th>Status</th><td><span class="admin-badge badge-{{ order.status }}" data-status-badge>{{ order.status }}</span></td></tr>
        <tr><th>Total</th><td class="cell-mono">{{ order.total }}</td></tr>
        <tr><th>Created At</th><td class="cell-muted">{{ order.createdAt ? order.createdAt|date('Y-m-d H:i:s') : '' }}</td></tr>
      </tbody>
    </table>
  </div>

  <div class="admin-form status-panel">
    <h2 class="form-title">Update status</h2>
    <form class="status-update-form" method="post" action="{{ path('app_order_pending_status', { no: order.orderNo }) }}" data-status-form>
      <input type="hidden" name="_token" value="{{ csrf_token('order_status_update' ~ order.id) }}">
      <label for="order-status">Status</label>
      <select class="status-select" name="status" id="order-status" data-status-select>
        {% for status in statuses %}
          <option value="{{ status }}"{{ order.status == status ? ' selected' : '' }}>{{ status }}</option>
        {% endfor %}
      </select>
      <button type="submit" class="btn btn-secondary">Update status</button>
      <span class="status-feedback" data-status-feedback role="status" aria-live="polite"></span>
    </form>
  </div>
{% endblock %}
