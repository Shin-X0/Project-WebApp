{% extends 'admin/layout.html.twig' %}

{% block title %}Orders — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <h1>Manage Orders</h1>
    <div class="admin-actions">
      <a href="{{ path('app_admin_orders_new') }}" class="btn">
        <span class="icon">&#9783;</span>
        <span>New Order</span>
      </a>
    </div>
  </header>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Order #</th>
          <th>Name</th>
          <th>Email</th>
          <th>Address</th>
          <th>City</th>
          <th>Zip</th>
          <th>Method</th>
          <th>Status</th>
          <th>Total</th>
          <th>Created At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
      {% for order in orders %}
        <tr>
          <td class="cell-mono">{{ order.id }}</td>
          <td class="cell-mono">{{ order.orderNo }}</td>
          <td>{{ order.name }}</td>
          <td class="cell-muted">{{ order.email }}</td>
          <td class="cell-muted">{{ order.address }}</td>
          <td class="cell-muted">{{ order.city }}</td>
          <td class="cell-mono">{{ order.zip }}</td>
          <td class="cell-muted">{{ order.paymentMethod }}</td>
          <td>
            <form class="status-update-form" method="post" action="{{ path('app_order_pending_status', { no: order.orderNo }) }}" data-status-form>
              <input type="hidden" name="_token" value="{{ csrf_token('order_status_update' ~ order.id) }}">
              <span class="admin-badge badge-{{ order.status }}" data-status-badge>{{ order.status }}</span>
              <label class="sr-only" for="status-{{ order.id }}">Update status for {{ order.orderNo }}</label>
              <select class="status-select" name="status" id="status-{{ order.id }}" data-status-select aria-label="Update status for {{ order.orderNo }}">
                {% for status in statuses %}
                  <option value="{{ status }}"{{ order.status == status ? ' selected' : '' }}>{{ status }}</option>
                {% endfor %}
              </select>
              <span class="status-feedback" data-status-feedback role="status" aria-live="polite"></span>
            </form>
          </td>
          <td class="cell-mono">{{ order.total }}</td>
          <td class="cell-muted">{{ order.createdAt ? order.createdAt|date('Y-m-d H:i:s') : '' }}</td>
          <td class="admin-actions-cell">
            <a href="{{ path('app_admin_orders_show', {'id': order.id}) }}" class="btn btn-sm">Show</a>
            <a href="{{ path('app_admin_orders_edit', {'id': order.id}) }}" class="btn btn-sm">Edit</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="12" class="cell-muted">No orders found</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="admin-pagination">
    <div class="pagination-links">
      <a href="{{ path('app_admin_orders_new') }}" class="btn btn-sm">
        <span class="icon">&#9783;</span>
        <span>New Order</span>
      </a>
    </div>
    <div class="results-count">{{ orders|length }} orders</div>
  </div>
{% endblock %}
