{% extends 'admin/layout.html.twig' %}

{% block title %}New Message — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <h1>New Contact Message</h1>
  </header>

  <div class="admin-form">
    <h3 class="form-title">Message Details</h3>
    {{ form_start(form) }}
      <div class="row">
        <div class="col-md-6">
          <div class="form-row">
            <label for="name">Name</label>
            {{ form_widget(form.name) }}
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-row">
            <label for="email">Email</label>
            {{ form_widget(form.email) }}
          </div>
        </div>
      </div>
      <div class="form-row">
        <label for="message">Message</label>
        {{ form_widget(form.message) }}
      </div>
      <div class="btn-row">
        <button type="submit" class="btn">Save Message</button>
        <a href="{{ path('app_admin_messages_index') }}" class="btn">Cancel</a>
      </div>
    {{ form_end(form) }}
  </div>
{% endblock %}
