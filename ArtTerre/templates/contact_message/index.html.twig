{% extends 'admin/layout.html.twig' %}

{% block title %}Messages — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <h1>Contact Messages</h1>
    <div class="admin-actions">
      <a href="{{ path('app_admin_messages_new') }}" class="btn">
        <span class="icon">&#9783;</span>
        <span>New Message</span>
      </a>
    </div>
  </header>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Email</th>
          <th>Message</th>
          <th>Status</th>
          <th>Created At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
      {% for contact_message in contact_messages %}
        <tr>
          <td class="cell-mono">{{ contact_message.id }}</td>
          <td>{{ contact_message.name }}</td>
          <td class="cell-muted">{{ contact_message.email }}</td>
          <td class="cell-muted">{{ contact_message.message }}</td>
          <td>
            {% if contact_message.isRead %}
              <span class="admin-badge badge-read">Read</span>
            {% else %}
              <span class="admin-badge badge-unread">Unread</span>
            {% endif %}
          </td>
          <td class="cell-muted">{{ contact_message.createdAt ? contact_message.createdAt|date('Y-m-d H:i:s') : '' }}</td>
          <td class="admin-actions-cell">
            <a href="{{ path('app_admin_messages_show', {'id': contact_message.id}) }}" class="btn btn-sm">Show</a>
            <a href="{{ path('app_admin_messages_edit', {'id': contact_message.id}) }}" class="btn btn-sm">Edit</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="7" class="cell-muted">No messages found</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="admin-pagination">
    <div class="pagination-links">
      <a href="{{ path('app_admin_messages_new') }}" class="btn btn-sm">
        <span class="icon">&#9783;</span>
        <span>New Message</span>
      </a>
    </div>
    <div class="results-count">{{ contact_messages|length }} messages</div>
  </div>
{% endblock %}
