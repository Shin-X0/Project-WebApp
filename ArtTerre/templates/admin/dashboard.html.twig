{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <h1>Dashboard</h1>
    <div class="admin-actions">
      <a href="{{ path('app_admin_users_index') }}" class="btn">
        <span class="icon">&#9783;</span>
        <span>Manage Users</span>
      </a>
      <a href="{{ path('app_admin_orders_index') }}" class="btn">
        <span class="icon">&#9670;</span>
        <span>Manage Orders</span>
      </a>
      <a href="{{ path('app_admin_messages_index') }}" class="btn">
        <span class="icon">&#10003;</span>
        <span>Open Inbox</span>
      </a>
      <a href="{{ path('app_admin_artworks_index') }}" class="btn">
        <span class="icon">&#9650;</span>
        <span>Manage Artworks</span>
      </a>
    </div>
  </header>

  <div class="admin-card-grid">
    <article class="admin-card">
      <div class="card-label">Users</div>
      <div class="card-value">{{ userCount }}</div>
      <div class="card-sub">Total registered users</div>
    </article>
    <article class="admin-card">
      <div class="card-label">Artists</div>
      <div class="card-value accent">{{ artistCount }}</div>
      <div class="card-sub">Users with artist role</div>
    </article>
    <article class="admin-card">
      <div class="card-label">Artworks</div>
      <div class="card-value clay">{{ artworkCount }}</div>
      <div class="card-sub">Available for sale</div>
    </article>
    <article class="admin-card">
      <div class="card-label">Orders</div>
      <div class="card-value">{{ orderCount }}</div>
      <div class="card-sub">All orders processed</div>
    </article>
    <article class="admin-card">
      <div class="card-label">Unread messages</div>
      <div class="card-value danger">{{ messageCount }}</div>
      <div class="card-sub">Messages awaiting reply</div>
    </article>
  </div>
{% endblock %}
