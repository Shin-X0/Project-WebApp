{% extends 'base.html.twig' %}

{% block title %}All Artists — Art Terre Creations{% endblock %}

{% block body %}
    <section class="page-hero">
      <div class="container">
        <h1 class="page-hero-title reveal">Artists</h1>
        <p class="page-hero-sub reveal">Meet the creative voices of Art Terre.</p>
      </div>
    </section>

    <section class="artists section">
      <div class="container">
        <div class="artist-grid">
          {% for entry in artists %}
            {% set user = entry.user %}
            <article class="artist-card reveal">
              <div class="artist-photo"><span class="artist-initials">{{ user.name|slice(0, 2)|upper }}</span></div>
              <div class="artist-foot">
                <button class="like-btn like-artist{{ user.id in likedByUser ? ' liked' : '' }}" type="button"
                        aria-label="Like {{ user.name }}"
                        aria-pressed="{{ user.id in likedByUser ? 'true' : 'false' }}"
                        data-artist-id="{{ user.id }}">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                </button>
                <div class="artist-meta">
                  <h3 class="artist-name">{{ user.name }}</h3>
                  <p class="order-note">{{ entry.artworkCount }} artwork{{ entry.artworkCount == 1 ? '' : 's' }}</p>
                </div>
                <span class="like-count" title="Likes">{{ entry.likeCount }}</span>
              </div>
            </article>
          {% else %}
            <p class="reveal">No artists have joined yet.</p>
          {% endfor %}
        </div>
      </div>
    </section>
{% endblock %}