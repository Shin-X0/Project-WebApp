{% extends 'base.html.twig' %}

{% block title %}My Sales — Art Terre Creations{% endblock %}

{% block body %}
    <section class="page-hero">
      <div class="container">
        <h1 class="page-hero-title reveal">My Sales</h1>
        <p class="page-hero-sub reveal">Orders that include your artworks — update the status as you process them.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        {% if orders is empty %}
          <p class="reveal">No orders with your artworks yet.</p>
        {% endif %}

        {% for order in orders %}
          <div class="auth-card reveal">
            <h2 class="cart-summary-title">Order {{ order.orderNo }}</h2>
            <p class="order-note">
              Status: <span class="order-status-text" data-status-text>{{ order.status }}</span> — {{ order.name }} · {{ order.email }} · total ${{ order.total }}
            </p>
            <ul>
              {% for item in order.items %}
                {% if item.artist and item.artist.id == app.user.id %}
                  <li>{{ item.qty }} × {{ item.title }} — ${{ item.price }}</li>
                {% endif %}
              {% endfor %}
            </ul>
            <form class="order-status-form" method="post" action="{{ path('app_order_pending_status', { no: order.orderNo }) }}" data-status-form>
              <input type="hidden" name="_token" value="{{ csrf_token('order_status_update' ~ order.id) }}">
              <label class="sr-only" for="sales-status-{{ order.id }}">Update status for {{ order.orderNo }}</label>
              <select class="status-select" name="status" id="sales-status-{{ order.id }}" data-status-select aria-label="Update status for {{ order.orderNo }}">
                {% for status in statuses %}
                  <option value="{{ status }}"{{ order.status == status ? ' selected' : '' }}>{{ status }}</option>
                {% endfor %}
              </select>
              <button type="submit" class="btn btn-accent order-status-save">Update status</button>
              <span class="status-feedback" data-status-feedback role="status" aria-live="polite"></span>
            </form>
          </div>
        {% endfor %}
      </div>
    </section>
{% endblock %}