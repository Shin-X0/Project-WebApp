{% extends 'admin/layout.html.twig' %}

{% block title %}User — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <h1>User Profile</h1>
    <div class="admin-actions">
      <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}" class="btn">
        <span class="icon">&#9998;</span>
        <span>Edit</span>
      </a>
      <a href="{{ path('app_admin_users_index') }}" class="btn">
        <span class="icon">&#8592;</span>
        <span>Back to list</span>
      </a>
    </div>
  </header>

  <div class="admin-form">
    <table class="admin-table">
      <tbody>
        <tr><th>Id</th><td>{{ user.id }}</td></tr>
        <tr><th>Name</th><td>{{ user.name }}</td></tr>
        <tr><th>Email</th><td>{{ user.email }}</td></tr>
        <tr><th>Password</th><td class="cell-muted">{{ user.password }}</td></tr>
        <tr><th>Dob</th><td>{{ user.dob ? user.dob|date('Y-m-d') : '' }}</td></tr>
        <tr><th>Gender</th><td>{{ user.gender }}</td></tr>
        <tr><th>Role</th><td>
          <span class="admin-badge badge-{{ user.role }}">{{ user.role }}</span>
        </td></tr>
        <tr><th>CreatedAt</th><td>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '' }}</td></tr>
      </tbody>
    </table>
  </div>
{% endblock %}
