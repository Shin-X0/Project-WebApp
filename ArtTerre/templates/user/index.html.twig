{% extends 'admin/layout.html.twig' %}

{% block title %}Users — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <h1>Manage Users</h1>
    <div class="admin-actions">
      <a href="{{ path('app_admin_users_new') }}" class="btn">
        <span class="icon">&#9783;</span>
        <span>Add User</span>
      </a>
    </div>
  </header>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Created At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
      {% for user in users %}
        <tr>
          <td class="cell-mono">{{ user.id }}</td>
          <td>
            <span class="admin-user-cell">
              <span class="admin-user-thumb">
                {% if user.hasProfilePhoto() %}
                  <img src="{{ asset(user.profileImagePath) }}" alt="" />
                {% else %}
                  {{ user.name|first|upper }}
                {% endif %}
              </span>
              {{ user.name }}
            </span>
          </td>
          <td>{{ user.email }}</td>
          <td>
            <span class="admin-badge badge-{{ user.role }}">
              {{ user.role }}
            </span>
          </td>
          <td class="cell-muted">{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '' }}</td>
          <td class="admin-actions-cell">
            <a href="{{ path('app_admin_users_show', {'id': user.id}) }}" class="btn btn-sm">Show</a>
            <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}" class="btn btn-sm">Edit</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" class="cell-muted">No users found</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="admin-pagination">
    <div class="pagination-links">
      <a href="{{ path('app_admin_users_new') }}" class="btn btn-sm">
        <span class="icon">&#9783;</span>
        <span>New User</span>
      </a>
    </div>
    <div class="results-count">{{ users|length }} users</div>
  </div>
{% endblock %}

