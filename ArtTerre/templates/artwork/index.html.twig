{% extends 'admin/layout.html.twig' %}

{% block title %}Manage Artworks — Admin{% endblock %}

{% block body %}
  {# Small summary numbers shown above the list. #}
  {% set paintingCount    = artworks|filter(a => a.category == 'painting')|length %}
  {% set photographyCount = artworks|filter(a => a.category == 'photography')|length %}
  {% set soldCount        = artworks|filter(a => a.status == 'sold')|length %}
  {% set availableCount   = artworks|length - soldCount %}

  <header class="admin-header">
    <div>
      <h1>Manage Artworks</h1>
      <p class="admin-header-sub">Review, edit and curate everything listed on Art Terre.</p>
    </div>
    <div class="admin-actions">
      <a href="{{ path('app_artworks') }}" class="btn" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
        <span>View site</span>
      </a>
      <a href="{{ path('app_admin_artworks_new') }}" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span>New Artwork</span>
      </a>
    </div>
  </header>

  {# ---------- Summary cards ---------- #}
  <div class="admin-card-grid">
    <article class="admin-card">
      <div class="card-label">Total</div>
      <div class="card-value">{{ artworks|length }}</div>
      <div class="card-sub">Artworks in the catalogue</div>
    </article>
    <article class="admin-card">
      <div class="card-label">Paintings</div>
      <div class="card-value accent">{{ paintingCount }}</div>
      <div class="card-sub">Painting listings</div>
    </article>
    <article class="admin-card">
      <div class="card-label">Photography</div>
      <div class="card-value clay">{{ photographyCount }}</div>
      <div class="card-sub">Photography listings</div>
    </article>
    <article class="admin-card">
      <div class="card-label">Sold</div>
      <div class="card-value danger">{{ soldCount }}</div>
      <div class="card-sub">{{ availableCount }} still available</div>
    </article>
  </div>

  {# ---------- Toolbar: search + category / status filters ---------- #}
  <div class="admin-toolbar">
    <div class="filter-group" data-filter-group="category" role="group" aria-label="Filter by category">
      <button type="button" class="filter-chip is-active" data-filter="all">All <span class="chip-count">{{ artworks|length }}</span></button>
      <button type="button" class="filter-chip" data-filter="painting">Paintings <span class="chip-count">{{ paintingCount }}</span></button>
      <button type="button" class="filter-chip" data-filter="photography">Photography <span class="chip-count">{{ photographyCount }}</span></button>
    </div>

    <div class="filter-group" data-filter-group="status" role="group" aria-label="Filter by status">
      <button type="button" class="filter-chip is-active" data-filter="all">Any status</button>
      <button type="button" class="filter-chip" data-filter="available">Available</button>
      <button type="button" class="filter-chip" data-filter="sold">Sold</button>
    </div>

    <div class="admin-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <label class="visually-hidden" for="artwork-search">Search artworks</label>
      <input type="search" id="artwork-search" placeholder="Search title, artist, ID…" data-filter-search autocomplete="off" />
      <span class="search-hint" aria-hidden="true">/</span>
    </div>
  </div>

  {# ---------- Artworks table ---------- #}
  <div class="admin-table-wrap">
    <table class="admin-table" data-filter-table>
      <thead>
        <tr>
          <th class="col-id">ID</th>
          <th>Artwork</th>
          <th>Category</th>
          <th>Price</th>
          <th>Status</th>
          <th>Created</th>
          <th class="col-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
      {% for artwork in artworks %}
        {% set artistName = artwork.artist ? artwork.artist.name : 'Unknown artist' %}
        <tr data-row
            data-category="{{ artwork.category }}"
            data-status="{{ artwork.status }}"
            data-search="{{ artwork.id }} {{ artwork.title }} {{ artwork.category }} {{ artwork.status }} {{ artistName }}">
          <td class="cell-mono col-id">{{ artwork.id }}</td>
          <td>
            <div class="artwork-cell">
              <span class="artwork-thumb">
                {% if artwork.imagePath %}
                  <img src="{{ asset(artwork.imagePath) }}" alt="" loading="lazy" />
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2.5"/><circle cx="8.5" cy="8.5" r="1.8"/><path d="m21 15-5-5L5 21"/></svg>
                {% endif %}
              </span>
              <span class="artwork-cell-meta">
                <span class="artwork-title" title="{{ artwork.title }}">{{ artwork.title }}</span>
                <span class="artwork-artist">{{ artistName }}</span>
              </span>
            </div>
          </td>
          <td><span class="admin-badge badge-category">{{ artwork.category }}</span></td>
          <td class="cell-price cell-nowrap">${{ artwork.price|number_format(2) }}</td>
          <td><span class="admin-badge badge-{{ artwork.status }}">{{ artwork.status }}</span></td>
          <td class="cell-muted cell-nowrap">{{ artwork.createdAt ? artwork.createdAt|date('d M Y') : '—' }}</td>
          <td>
            <div class="admin-actions-cell">
              <a href="{{ path('app_admin_artworks_show', {'id': artwork.id}) }}" class="btn btn-sm" title="View artwork">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.6"/></svg>
                <span>Show</span>
              </a>
              <a href="{{ path('app_admin_artworks_edit', {'id': artwork.id}) }}" class="btn btn-sm btn-secondary" title="Edit artwork">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                <span>Edit</span>
              </a>
              <form method="post"
                    action="{{ path('app_admin_artworks_delete', {'id': artwork.id}) }}"
                    onsubmit="return confirm('Delete this artwork? This cannot be undone.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ artwork.id) }}" />
                <button type="submit" class="btn btn-sm btn-danger" title="Delete artwork">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4.5A1.5 1.5 0 0 1 9.5 3h5A1.5 1.5 0 0 1 16 4.5V6"/><path d="M19 6v13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
                  <span class="visually-hidden">Delete</span>
                </button>
              </form>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="7" class="empty-cell">No artworks yet — add your first piece to get started.</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {# Shown by admin.js when the filters match nothing. #}
  <div class="admin-empty" data-filter-empty hidden>
    <span class="empty-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </span>
    <h3>No matching artworks</h3>
    <p>Try a different search term or clear the filters to see the full catalogue.</p>
  </div>

  <div class="admin-pagination">
    <div class="pagination-links">
      <a href="{{ path('app_admin_artworks_new') }}" class="btn btn-sm btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span>New Artwork</span>
      </a>
    </div>
    <div class="results-count" data-filter-count>{{ artworks|length }} artwork{{ artworks|length == 1 ? '' : 's' }}</div>
  </div>

{% endblock %}
