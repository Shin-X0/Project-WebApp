<form method="post" action="{{ path('app_admin_artworks_delete', {'id': artwork.id}) }}" onsubmit="return confirm('Delete this artwork? This cannot be undone.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ artwork.id) }}">
    <button class="btn btn-danger" type="submit">Delete artwork</button>
</form>
