{% extends 'admin/layout.html.twig' %}

{% block title %}{{ artwork.title }} — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <div>
      <h1>{{ artwork.title }}</h1>
      <p class="admin-header-sub">Artwork #{{ artwork.id }} · created {{ artwork.createdAt ? artwork.createdAt|date('d M Y, H:i') : '—' }}</p>
    </div>
    <div class="admin-actions">
      <a href="{{ path('app_admin_artworks_index') }}" class="btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        <span>Back to list</span>
      </a>
      <a href="{{ path('app_admin_artworks_edit', {'id': artwork.id}) }}" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
        <span>Edit artwork</span>
      </a>
    </div>
  </header>

  <div class="admin-detail">
    <div class="admin-form artwork-preview">
      <h2 class="form-title">Preview</h2>
      <div class="artwork-preview-media">
        {% if artwork.imagePath %}
          <img src="{{ asset(artwork.imagePath) }}" alt="{{ artwork.title }}" />
        {% else %}
          <span class="artwork-preview-empty" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2.5"/><circle cx="8.5" cy="8.5" r="1.8"/><path d="m21 15-5-5L5 21"/></svg>
          </span>
        {% endif %}
      </div>
      <div class="artwork-preview-meta">
        <span class="admin-badge badge-{{ artwork.status }}">{{ artwork.status }}</span>
        <span class="admin-badge badge-category">{{ artwork.category }}</span>
      </div>
      <div class="artwork-preview-price">${{ artwork.price|number_format(2) }}</div>
    </div>

    <div class="admin-form">
      <h2 class="form-title">Details</h2>
      <table class="admin-table">
        <tbody>
          <tr><th>ID</th><td class="cell-mono">{{ artwork.id }}</td></tr>
          <tr><th>Title</th><td>{{ artwork.title }}</td></tr>
          <tr><th>Artist</th><td>{{ artwork.artist ? artwork.artist.name : '—' }}</td></tr>
          <tr><th>Category</th><td>{{ artwork.category|capitalize }}</td></tr>
          <tr><th>Price</th><td class="cell-price">${{ artwork.price|number_format(2) }}</td></tr>
          <tr><th>Status</th><td><span class="admin-badge badge-{{ artwork.status }}">{{ artwork.status }}</span></td></tr>
          <tr><th>Image path</th><td class="cell-muted">{{ artwork.imagePath ?: '—' }}</td></tr>
          <tr><th>Created</th><td class="cell-muted">{{ artwork.createdAt ? artwork.createdAt|date('d M Y, H:i') : '—' }}</td></tr>
        </tbody>
      </table>

      <h2 class="form-title form-title--spaced">Story</h2>
      <p class="artwork-story">{{ artwork.story ?: 'No story has been added for this piece yet.' }}</p>

      <div class="btn-row">
        {{ include('artwork/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
{% endblock %}
