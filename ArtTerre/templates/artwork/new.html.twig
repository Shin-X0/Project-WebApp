{% extends 'admin/layout.html.twig' %}

{% block title %}New Artwork — Admin{% endblock %}

{% block body %}
  <header class="admin-header">
    <div>
      <h1>New Artwork</h1>
      <p class="admin-header-sub">Add a new piece to the Art Terre catalogue.</p>
    </div>
    <div class="admin-actions">
      <a href="{{ path('app_admin_artworks_index') }}" class="btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        <span>Back to list</span>
      </a>
    </div>
  </header>

  <div class="admin-form">
    <h3 class="form-title">Artwork Details</h3>
    {{ form_start(form) }}
      <div class="row">
        <div class="form-row">
          <label for="{{ form.title.vars.id }}">Title</label>
          {{ form_widget(form.title) }}
          {{ form_errors(form.title) }}
        </div>
        <div class="form-row">
          <label for="{{ form.category.vars.id }}">Category</label>
          {{ form_widget(form.category) }}
          {{ form_errors(form.category) }}
        </div>
      </div>

      <div class="row">
        <div class="form-row">
          <label for="{{ form.price.vars.id }}">Price</label>
          {{ form_widget(form.price) }}
          {{ form_errors(form.price) }}
        </div>
        <div class="form-row">
          <label for="{{ form.status.vars.id }}">Status</label>
          {{ form_widget(form.status) }}
          {{ form_errors(form.status) }}
        </div>
      </div>

      <div class="row">
        <div class="form-row">
          <label for="{{ form.artist.vars.id }}">Artist</label>
          {{ form_widget(form.artist) }}
          {{ form_errors(form.artist) }}
        </div>
        <div class="form-row">
          <label for="{{ form.createdAt.vars.id }}">Created at</label>
          {{ form_widget(form.createdAt) }}
          {{ form_errors(form.createdAt) }}
        </div>
      </div>

      <div class="form-row">
        <label for="{{ form.imagePath.vars.id }}">Image path</label>
        {{ form_widget(form.imagePath) }}
        {{ form_errors(form.imagePath) }}
        <p class="field-hint">Relative path to the image, for example <code>uploads/artworks/my-piece.jpg</code>.</p>
      </div>

      <div class="form-row">
        <label for="{{ form.story.vars.id }}">Story / Description</label>
        {{ form_widget(form.story) }}
        {{ form_errors(form.story) }}
      </div>

      <div class="btn-row">
        <button type="submit" class="btn btn-primary">Save Artwork</button>
        <a href="{{ path('app_admin_artworks_index') }}" class="btn">Cancel</a>
      </div>
    {{ form_end(form) }}
  </div>
{% endblock %}
