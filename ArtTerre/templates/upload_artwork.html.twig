{% extends 'base.html.twig' %}

{% block title %}Sell Artwork — Art Terre Creations{% endblock %}

{% block body %}
    <section class="page-hero">
      <div class="container">
        <h1 class="page-hero-title reveal">Sell Artwork</h1>
        <p class="page-hero-sub reveal">Upload your piece — add a title, story, and price. Buyers find it on the artworks page.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="auth-card reveal">
          <form class="auth-form" method="post" action="{{ path('app_upload_artwork_submit') }}" enctype="multipart/form-data" novalidate>
            <div class="field">
              <label for="up-title">Title</label>
              <input type="text" id="up-title" name="title" required value="{{ old.title ?? '' }}" />
              {% if errors.title is defined %}<p class="field-error">{{ errors.title }}</p>{% endif %}
            </div>
            <div class="field">
              <label for="up-category">Category</label>
              <select id="up-category" name="category">
                <option value="painting"{{ old.category != 'photography' ? ' selected' : '' }}>Painting</option>
                <option value="photography"{{ old.category == 'photography' ? ' selected' : '' }}>Photography</option>
              </select>
              {% if errors.category is defined %}<p class="field-error">{{ errors.category }}</p>{% endif %}
            </div>
            <div class="field">
              <label for="up-price">Price (USD)</label>
              <input type="text" id="up-price" name="price" inputmode="decimal" required value="{{ old.price ?? '' }}" />
              {% if errors.price is defined %}<p class="field-error">{{ errors.price }}</p>{% endif %}
            </div>
            <div class="field">
              <label for="up-story">Story</label>
              <textarea id="up-story" name="story" rows="4">{{ old.story ?? '' }}</textarea>
            </div>
            <div class="field">
              <label for="up-image">Image (JPG, PNG, WEBP, GIF — max 4 MB)</label>
              <input type="file" id="up-image" name="image" accept="image/*" />
              {% if errors.image is defined %}<p class="field-error">{{ errors.image }}</p>{% endif %}
            </div>
            <button type="submit" class="btn btn-accent auth-submit">Upload artwork</button>
          </form>
        </div>
      </div>
    </section>
{% endblock %}